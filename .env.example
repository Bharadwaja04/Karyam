# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored, so your keys stay on your computer.
# Real environment variables override this file. You can also skip this file and type the keys into Settings
# in the page (they stay in your browser and are sent only with your own requests).

# Gnani speech (speech-to-text and text-to-speech). Get a key at https://app.gnani.ai
GNANI_API_KEY=

# Language model: any OpenAI-compatible chat endpoint. Example below is Google AI Studio (Gemini).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Only if your language model runs on this computer (for example Ollama at http://localhost:11434/v1):
# ALLOW_PRIVATE_LLM_HOSTS=1
